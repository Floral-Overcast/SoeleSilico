# Soele config. Copy to /etc/hub.env, chmod 600 (it will hold a credential).
# Everything is optional except the token; unset features simply don't appear.

# --- identity ---------------------------------------------------------------
# HUB_NODE=main            # this node's name (shows on session badges)
# HUB_LABEL=home           # display name in the UI (routing still uses HUB_NODE)

# --- Claude Code (the default engine) ---------------------------------------
# A long-lived token from `claude setup-token`. Never commit this anywhere.
CLAUDE_CODE_OAUTH_TOKEN=
# HUB_CLAUDE_BIN=/usr/local/bin/claude
# HUB_MODEL=               # pin spawned turns to a model id (empty = CLI default)
# HUB_PERM=                # extra permission args for spawned turns

# --- multi-node (optional) --------------------------------------------------
# Peers this gateway merges and proxies. name=url pairs, comma separated
# (NOT JSON - systemd strips quotes). Every peer runs this same daemon.
# HUB_PEERS=study=http://192.0.2.10:8801
# HUB_DEFAULT_NODE=        # new chats land on this peer by default

# --- worker containers (optional, Proxmox host only) ------------------------
# HUB_CTS=1                # enable the CT lifecycle (clone/start/stop via pct)
# HUB_CT_BASE_IP=          # the golden template's static IP, e.g. 192.0.2.220
                           # (clones get the same /24 with their CTID as last octet)

# --- local model row (optional, any OpenAI-compatible server) ---------------
# HUB_LMSTUDIO_CMD=        # terminal-mode command for the local row (its presence enables the row)
# HUB_LMSTUDIO_API=        # e.g. http://192.0.2.2:1234/v1
# HUB_LMSTUDIO_API_KEY=
# HUB_LMSTUDIO_MODEL=
# HUB_LMSTUDIO_TITLE=local model
# HUB_LMSTUDIO_CWD=

# --- session sweep (optional) -----------------------------------------------
# An LLM reads each chat and suggests archive/delete; nothing happens without
# your approval in the UI.
# HUB_SWEEP_LLM=           # OpenAI-compatible base URL of the reviewer
# HUB_SWEEP_MODEL=
# HUB_SWEEP_HOURS=0        # >0 = periodic auto-sweep; 0 = manual only

# --- phone push (optional, HTTPS origin only) -------------------------------
# HUB_PUSH_EMAIL=you@example.com   # VAPID contact claim sent to the push service
# HUB_NOTIFY_URL=          # peer nodes: forward turn-done pings to the gateway's /api/notify

# --- Android app (optional, see docs/ANDROID.md) ----------------------------
# Serve /.well-known/assetlinks.json for your self-built TWA APK.
# HUB_TWA_PACKAGE=          # e.g. com.example.soele
# HUB_TWA_FINGERPRINT=      # apksigner verify --print-certs <apk>

# --- usage meter (optional) -------------------------------------------------
# Real rate-limit numbers, tapped from response headers via the bundled proxy
# (proxy.py, hub-proxy.service). Point your Claude Code at the proxy and the
# meter lights up; without it the meter stays hidden.
# HUB_PROXY_PORT=8811
# HUB_PROXY_UPSTREAM=https://api.anthropic.com
# HUB_FEED_PATH=           # where the snapshot lives (default ~/.hub-usage.json)
# HUB_PLAN=                # optional plan label reported with usage (e.g. "Max")
